# Enable mod_rewrite
RewriteEngine On

# ----------------------------------------------------
# 1. Redirect non-www to www (e.g. gphomes.in → www.gphomes.in)
RewriteCond %{HTTP_HOST} ^gphomes\.in$ [NC]
RewriteRule ^(.*)$ https://www.gphomes.in/$1 [L,R=301]

# ----------------------------------------------------
# 2. Redirect /home to /
# Works for:
#   - https://gphomes.in/home
#   - https://www.gphomes.in/home
RewriteCond %{THE_REQUEST} \s/home[\s?] [NC]
RewriteRule ^home$ / [L,R=301]

# ----------------------------------------------------
# 3. React.js routing fallback for non-existent files/folders
# This makes React handle all internal routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Redirect old blog URLs to home
Redirect 301 /what-are-the-benefits-of-buying-a-flat-in-padur/ /
Redirect 301 /find-the-perfect-plot-of-land-for-your-business-in-thirunindravur/ /

# Redirect specific plots to apartments page
Redirect 301 /plots-chennai/gp-valencia-emarald-2bhk /apartments-chennai
Redirect 301 /plots-chennai/gp-blazing-star-2bhk /apartments-chennai
Redirect 301 /plots-chennai/gp-valencia-emarald-3bhk /apartments-chennai
Redirect 301 /plots-chennai/gp-valencia-ruby-2bhk /apartments-chennai

